NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# SePay webhook (my.sepay.vn → Webhooks → API Key). Use a different key per environment.
SEPAY_WEBHOOK_API_KEY=
# Fund account number linked in SePay; transactions of other accounts are ignored.
FUND_BANK_ACCOUNT=
# Fund account holder name, removed from transfer content before matching senders.
FUND_ACCOUNT_HOLDER_NAME=

# Zalo Bot (Zalo Bot Creator). Chat id of the team group or the treasurer.
ZALO_BOT_TOKEN=
ZALO_CHAT_ID=

# Upstash Redis REST (free tier): one alert per failed webhook instead of one per retry.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Vercel Cron secret (keeps the free Supabase project from pausing).
CRON_SECRET=
